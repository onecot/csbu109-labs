PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/shopadmin_db
JWT_SECRET=replace-with-your-own-secret
JWT_EXPIRES_IN=7d

# Google Sign-In (same Client ID as LAB5_HW_FE/config.js)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Gmail SMTP (16-character App Password, 2-Step Verification must be on)
GMAIL_USER=your-shop@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Exercise 3 / homework cron test knobs (defaults: every minute / hourly / 24h / midnight)
# INVENTORY_SCHEDULE=* * * * *
# ARCHIVE_SCHEDULE=0 * * * *
# ARCHIVE_AFTER_MINUTES=1440
# REVENUE_SCHEDULE=0 0 * * *
